---
import { HomePage } from '@/features/home';
import { getTranslations, resolveLocale } from '@/shared/i18n';
import BaseLayout from '@/shared/layout/BaseLayout.astro';
import { localeStaticPaths } from '@/shared/lib/locale-paths';

export function getStaticPaths() {
	return localeStaticPaths();
}

const locale = resolveLocale(Astro.params.locale);
const t = getTranslations(locale);
---

<BaseLayout
	locale={locale}
	title={t.pages.home.title}
	description={t.pages.home.description}
>
	<HomePage locale={locale} />
</BaseLayout>
