---
import PriceCard from '@/features/lessons/components/PriceCard.astro';
import { getLessonsCopy } from '@/features/lessons/content';
import { localePath, navRoutes } from '@/shared/lib/paths';
import Button from '@/shared/ui/Button.astro';
import type { Locale } from '@/shared/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = getLessonsCopy(locale);
const contactHref = localePath(locale, navRoutes.contact);
const examsHref = localePath(locale, navRoutes.deleSiele);
---

<section class="mx-auto max-w-6xl px-4 pb-8 pt-10 sm:px-6 sm:pb-10 sm:pt-14">
	<div data-reveal class="reveal max-w-2xl">
		<p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary">
			{copy.hero.eyebrow}
		</p>
		<h1
			class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl"
		>
			{copy.hero.title}
		</h1>
		<p class="mt-4 text-lg leading-relaxed text-muted">{copy.hero.lead}</p>
	</div>
</section>

<section class="mx-auto max-w-6xl px-4 pb-14 sm:px-6 sm:pb-16">
	<div
		data-reveal
		class="reveal rounded-3xl border border-border bg-surface-elevated p-6 sm:p-8"
	>
		<h2 class="font-display text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
			{copy.intake.title}
		</h2>
		<p class="mt-3 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
			{copy.intake.intro}
		</p>
		<ul class="mt-8 grid gap-3 sm:grid-cols-2">
			{
				copy.intake.questions.map((question) => (
					<li class="flex gap-3 rounded-2xl border border-border bg-surface px-4 py-3.5 text-sm leading-snug text-ink sm:text-base">
						<span
							class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"
							aria-hidden="true"
						/>
						<span>{question}</span>
					</li>
				))
			}
		</ul>
	</div>
</section>

<section class="bg-surface-elevated">
	<div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
		<div data-reveal class="reveal max-w-2xl">
			<p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary">
				{copy.individual.eyebrow}
			</p>
			<h2
				class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl"
			>
				{copy.individual.title}
			</h2>
			<p class="mt-4 text-lg leading-relaxed text-muted">{copy.individual.lead}</p>
		</div>
		<ul class="mt-8 grid gap-3 sm:grid-cols-2">
			{
				copy.individual.benefits.map((benefit) => (
					<li data-reveal class="reveal flex gap-3 text-sm leading-relaxed text-muted sm:text-base">
						<span
							class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"
							aria-hidden="true"
						/>
						<span>{benefit}</span>
					</li>
				))
			}
		</ul>
		<ul class="mt-10 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
			{
				copy.individual.plans.map((plan, index) => (
					<li data-reveal class="reveal" style={`transition-delay: ${index * 60}ms`}>
						<PriceCard
							plan={plan}
							ctaLabel={copy.book}
							ctaHref={contactHref}
							featured={index === 2}
						/>
					</li>
				))
			}
		</ul>
	</div>
</section>

<section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-16">
	<div data-reveal class="reveal max-w-2xl">
		<p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary">
			{copy.group.eyebrow}
		</p>
		<h2
			class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl"
		>
			{copy.group.title}
		</h2>
		<p class="mt-4 text-lg leading-relaxed text-muted">{copy.group.lead}</p>
	</div>
	<ul class="mt-8 grid gap-3 sm:grid-cols-2">
		{
			copy.group.benefits.map((benefit) => (
				<li data-reveal class="reveal flex gap-3 text-sm leading-relaxed text-muted sm:text-base">
					<span
						class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"
						aria-hidden="true"
					/>
					<span>{benefit}</span>
				</li>
			))
		}
	</ul>
	<ul class="mt-10 grid gap-5 md:grid-cols-2">
		{
			copy.group.plans.map((plan, index) => (
				<li data-reveal class="reveal" style={`transition-delay: ${index * 60}ms`}>
					<PriceCard
						plan={plan}
						ctaLabel={copy.book}
						ctaHref={contactHref}
						featured={index === 1}
					/>
				</li>
			))
		}
	</ul>
</section>

<section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 sm:pb-20">
	<div
		data-reveal
		class="reveal flex flex-col gap-6 rounded-3xl border border-border bg-surface-elevated p-6 sm:p-8 md:flex-row md:items-center md:justify-between"
	>
		<div class="max-w-xl">
			<h2 class="font-display text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
				{copy.exams.title}
			</h2>
			<p class="mt-3 text-base leading-relaxed text-muted sm:text-lg">
				{copy.exams.text}
			</p>
		</div>
		<Button href={examsHref} variant="primary">
			{copy.exams.button}
		</Button>
	</div>
</section>

<section class="bg-primary text-primary-foreground">
	<div
		class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-14 sm:px-6 sm:py-16 md:flex-row md:items-center md:justify-between"
	>
		<div class="max-w-xl">
			<h2 class="font-display text-3xl font-semibold tracking-tight">
				{copy.cta.title}
			</h2>
			<p class="mt-3 text-base text-primary-foreground/85 sm:text-lg">
				{copy.cta.text}
			</p>
		</div>
		<Button href={contactHref} variant="secondary">
			{copy.cta.button}
		</Button>
	</div>
</section>
