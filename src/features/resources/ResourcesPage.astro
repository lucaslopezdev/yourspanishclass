---
import { Image } from 'astro:assets';
import ResourceCard from '@/features/resources/components/ResourceCard.astro';
import { getResources } from '@/features/resources/content';
import { localePath, navRoutes } from '@/shared/lib/paths';
import Button from '@/shared/ui/Button.astro';
import type { Locale } from '@/shared/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const { page, items } = getResources(locale);
---

<section class="mx-auto max-w-6xl px-4 pb-8 pt-10 sm:px-6 sm:pb-10 sm:pt-14">
	<div data-reveal class="reveal max-w-2xl">
		<p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary">
			{page.eyebrow}
		</p>
		<h1
			class="mt-3 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl"
		>
			{page.title}
		</h1>
		<p class="mt-4 text-lg leading-relaxed text-muted">{page.lead}</p>
	</div>
</section>

<section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 sm:pb-20">
	<ul class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
		{
			items.map((item, index) => (
				<li data-reveal class="reveal" style={`transition-delay: ${index * 80}ms`}>
					<ResourceCard
						item={item}
						viewLabel={page.view}
						downloadLabel={page.download}
					/>
				</li>
			))
		}
	</ul>
</section>

<dialog
	id="resource-viewer"
	data-resource-viewer
	aria-labelledby="resource-viewer-title"
	class="fixed inset-4 m-auto h-[min(92dvh,58rem)] w-[min(calc(100%-1.5rem),56rem)] max-w-none flex-col overflow-hidden rounded-2xl border border-border bg-surface p-0 text-ink shadow-2xl backdrop:bg-secondary/70 open:flex"
>
	<div
		class="flex shrink-0 items-center gap-3 border-b border-border px-4 py-3 sm:px-5"
	>
		<h2
			id="resource-viewer-title"
			data-resource-title
			class="min-w-0 flex-1 truncate font-display text-lg font-semibold"
		>
		</h2>
		<a
			href="#"
			data-resource-download
			class="hidden rounded-lg px-4 py-2.5 text-sm font-semibold tracking-wide text-primary transition duration-200 hover:bg-primary/10 sm:inline-flex"
		>
			{page.download}
		</a>
		<button
			type="button"
			class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg text-ink transition duration-200 hover:bg-primary/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30"
			data-resource-close
			aria-label={page.close}
		>
			<svg
				class="h-5 w-5"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				aria-hidden="true"
			>
				<path d="M6 6l12 12M18 6L6 18"></path>
			</svg>
		</button>
	</div>
	<div data-resource-pages class="min-h-0 flex-1 overflow-y-auto bg-secondary/5">
		{
			items.map((item) => (
				<div hidden data-resource-page-set={item.id} class="space-y-4 p-3 sm:p-5">
					{item.pages.map((pageImage, index) => (
						<Image
							src={pageImage}
							alt={`${item.title} (${index + 1}/${item.pages.length})`}
							class="mx-auto w-full max-w-lg rounded-xl bg-surface-elevated shadow-sm"
							widths={[480, 720, 960, 1200]}
							sizes="(min-width: 768px) 720px, 92vw"
						/>
					))}
				</div>
			))
		}
	</div>
	<p class="shrink-0 border-t border-border px-4 py-3 text-sm text-muted sm:px-5">
		{page.viewerFallback}
		{' '}
		<a
			href="#"
			data-resource-download
			class="font-semibold text-primary underline-offset-2 hover:underline"
		>
			{page.download}
		</a>
	</p>
</dialog>

<section class="bg-primary text-primary-foreground">
	<div
		class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-14 sm:px-6 sm:py-16 md:flex-row md:items-center md:justify-between"
	>
		<div class="max-w-xl">
			<h2 class="font-display text-3xl font-semibold tracking-tight">
				{page.cta.title}
			</h2>
			<p class="mt-3 text-base text-primary-foreground/85 sm:text-lg">
				{page.cta.text}
			</p>
		</div>
		<Button href={localePath(locale, navRoutes.contact)} variant="secondary">
			{page.cta.button}
		</Button>
	</div>
</section>

<style>
	dialog[data-resource-viewer][open] {
		display: flex;
	}
</style>

<script>
	import '@/features/resources/viewer';
</script>
