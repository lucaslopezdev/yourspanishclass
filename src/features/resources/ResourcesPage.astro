---
import { getTranslations, type Locale } from '@/shared/i18n';
import { localePath, navRoutes } from '@/shared/lib/paths';
import SectionPlaceholder from '@/shared/ui/SectionPlaceholder.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<SectionPlaceholder
	title={t.pages.resources.title}
	description={t.pages.resources.description}
	placeholder={t.placeholders.sectionReady}
	ctaLabel={t.cta.learnMore}
	ctaHref={localePath(locale, navRoutes.contact)}
/>
