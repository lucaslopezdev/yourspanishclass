---
import ContactForm from '@/features/contact/ContactForm.astro';
import { getTranslations, type Locale } from '@/shared/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
	<div class="max-w-2xl">
		<p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary">
			{t.nav.contact}
		</p>
		<h1
			class="mt-4 font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl"
		>
			{t.pages.contact.title}
		</h1>
		<p class="mt-4 text-lg text-muted">{t.pages.contact.description}</p>
		<p class="mt-2 text-sm text-muted">{t.placeholders.sectionReady}</p>
		<ContactForm locale={locale} />
	</div>
</section>
