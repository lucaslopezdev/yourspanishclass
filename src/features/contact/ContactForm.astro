---
import { getTranslations, type Locale } from '@/shared/i18n';
import Button from '@/shared/ui/Button.astro';

interface Props {
	locale: Locale;
	class?: string;
}

const { locale, class: className = 'mt-8' } = Astro.props;
const t = getTranslations(locale);
---

<form
	class:list={[className, 'grid max-w-xl gap-4']}
	method="post"
	action="#"
	data-contact-form
>
	<label class="grid gap-1.5 text-sm font-medium text-ink">
		<span>{t.form.name}</span>
		<input
			type="text"
			name="name"
			required
			autocomplete="name"
			class="rounded-lg border border-border bg-surface-elevated px-3 py-2.5 text-base text-ink transition duration-200 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30"
		/>
	</label>

	<label class="grid gap-1.5 text-sm font-medium text-ink">
		<span>{t.form.email}</span>
		<input
			type="email"
			name="email"
			required
			autocomplete="email"
			class="rounded-lg border border-border bg-surface-elevated px-3 py-2.5 text-base text-ink transition duration-200 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30"
		/>
	</label>

	<label class="grid gap-1.5 text-sm font-medium text-ink">
		<span>{t.form.message}</span>
		<textarea
			name="message"
			required
			rows="5"
			class="resize-y rounded-lg border border-border bg-surface-elevated px-3 py-2.5 text-base text-ink transition duration-200 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30"
		></textarea>
	</label>

	<div>
		<Button type="submit" variant="primary">{t.form.submit}</Button>
	</div>
</form>
