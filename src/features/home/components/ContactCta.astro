---
import ContactForm from '@/features/contact/ContactForm.astro';
import { getHomeCopy } from '@/features/home/content';
import type { Locale } from '@/shared/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = getHomeCopy(locale);
---

<section id="contacto" class="scroll-mt-28 bg-surface-elevated">
	<div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
		<div data-reveal class="reveal">
			<p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary">
				{copy.contact.eyebrow}
			</p>
			<h2
				class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl"
			>
				{copy.contact.title}
			</h2>
			<p class="mt-4 max-w-md text-lg leading-relaxed text-muted">
				{copy.contact.text}
			</p>
		</div>
		<div data-reveal class="reveal rounded-3xl border border-border bg-surface p-6 sm:p-8">
			<ContactForm locale={locale} class="max-w-none" />
		</div>
	</div>
</section>
