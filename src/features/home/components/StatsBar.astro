---
import { getHomeCopy } from '@/features/home/content';
import type { Locale } from '@/shared/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = getHomeCopy(locale);
---

<section class="bg-primary text-primary-foreground">
	<div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-14">
		<p
			class="text-center text-sm font-semibold uppercase tracking-[0.18em] text-primary-foreground/80"
		>
			{copy.stats.title}
		</p>
		<div class="mt-8 grid grid-cols-2 gap-8 sm:gap-10 lg:grid-cols-4">
			{
				copy.stats.items.map((item) => (
					<div class="text-center">
						<p
							class="font-display text-4xl font-semibold tracking-tight sm:text-5xl"
							data-count-up
							data-count-to={item.value}
							data-count-prefix={item.prefix}
						>
							{item.prefix}0
						</p>
						<p class="mt-2 text-sm font-medium text-primary-foreground/80">
							{item.label}
						</p>
					</div>
				))
			}
		</div>
	</div>
</section>
