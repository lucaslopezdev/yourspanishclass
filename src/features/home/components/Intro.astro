---
import { Image } from 'astro:assets';
import aboutPhoto from '@/assets/cristina-about-me.jpg';
import { getHomeCopy } from '@/features/home/content';
import type { Locale } from '@/shared/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = getHomeCopy(locale);
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
	<div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
		<div data-reveal class="reveal order-2 lg:order-1">
			<div class="overflow-hidden rounded-3xl border border-border">
				<Image
					src={aboutPhoto}
					alt={copy.intro.imageAlt}
					class="aspect-[4/5] w-full object-cover object-[center_15%]"
					widths={[480, 720, 960]}
					sizes="(min-width: 1024px) 480px, 90vw"
				/>
			</div>
		</div>

		<div data-reveal class="reveal order-1 lg:order-2">
			<p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary">
				{copy.intro.eyebrow}
			</p>
			<h2
				class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl"
			>
				{copy.intro.title}
			</h2>
			{
				copy.intro.paragraphs.map((paragraph) => (
					<p class="mt-4 text-base leading-relaxed text-muted sm:text-lg">
						{paragraph}
					</p>
				))
			}
			<p
				class="mt-6 rounded-2xl border border-primary/20 bg-primary/10 px-4 py-4 text-sm leading-relaxed text-ink sm:text-base"
			>
				{copy.intro.highlight}
			</p>
		</div>
	</div>
</section>
