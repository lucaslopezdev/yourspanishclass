---
import { getHomeCopy } from '@/features/home/content';
import { localePath, navRoutes } from '@/shared/lib/paths';
import Button from '@/shared/ui/Button.astro';
import type { Locale } from '@/shared/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = getHomeCopy(locale);
---

<section class="bg-surface-elevated">
	<div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
		<div data-reveal class="reveal mx-auto max-w-2xl text-center">
			<p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary">
				{copy.services.eyebrow}
			</p>
			<h2
				class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl"
			>
				{copy.services.title}
			</h2>
		</div>

		<ul class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
			{
				copy.services.items.map((item, index) => (
					<li
						data-reveal
						class="reveal flex h-full flex-col rounded-3xl border border-border bg-surface p-6 transition duration-200 hover:border-primary/40 hover:shadow-lg sm:p-8"
						style={`transition-delay: ${index * 80}ms`}
					>
						<h3 class="font-display text-2xl font-semibold text-ink">
							{item.title}
						</h3>
						<ul class="mt-5 flex flex-1 flex-col gap-3 text-sm leading-relaxed text-muted sm:text-base">
							{item.bullets.map((bullet) => (
								<li class="flex gap-2">
									<span
										class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"
										aria-hidden="true"
									/>
									<span>{bullet}</span>
								</li>
							))}
						</ul>
						<div class="mt-8">
							<Button
								href={localePath(locale, navRoutes[item.hrefKey])}
								variant="ghost"
							>
								{item.cta}
							</Button>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>
