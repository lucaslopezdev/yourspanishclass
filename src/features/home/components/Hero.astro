---
import { Image } from 'astro:assets';
import heroPhoto from '@/assets/cristina-home.jpg';
import { getHomeCopy } from '@/features/home/content';
import { localePath, navRoutes } from '@/shared/lib/paths';
import Button from '@/shared/ui/Button.astro';
import type { Locale } from '@/shared/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = getHomeCopy(locale);
---

<section class="mx-auto max-w-6xl px-4 pb-12 pt-10 sm:px-6 sm:pb-16 sm:pt-14">
	<div class="grid items-center gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
		<div data-reveal class="reveal">
			<p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary">
				{copy.hero.eyebrow}
			</p>
			<h1
				class="mt-4 max-w-xl font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl lg:text-[3.25rem] lg:leading-[1.1]"
			>
				{copy.hero.title}
			</h1>
			<p class="mt-5 max-w-lg text-lg leading-relaxed text-muted">
				{copy.hero.subtitle}
			</p>
			<div class="mt-8 flex flex-wrap gap-3">
				<Button href="#contacto" variant="primary">
					{copy.hero.ctaPrimary}
				</Button>
				<Button
					href={localePath(locale, navRoutes.deleSiele)}
					variant="secondary"
				>
					{copy.hero.ctaSecondary}
				</Button>
			</div>
		</div>

		<div data-reveal class="reveal lg:justify-self-end">
			<div
				class="relative overflow-hidden rounded-3xl border border-border shadow-[0_24px_60px_-28px_rgba(15,107,107,0.45)]"
			>
				<Image
					src={heroPhoto}
					alt={copy.hero.imageAlt}
					class="aspect-[4/5] h-full w-full object-cover object-[center_20%] sm:max-h-[36rem]"
					widths={[480, 720, 960]}
					sizes="(min-width: 1024px) 480px, 90vw"
				/>
			</div>
		</div>
	</div>
</section>
