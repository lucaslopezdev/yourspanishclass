---
import { getHomeCopy } from '@/features/home/content';
import { localePath, navRoutes } from '@/shared/lib/paths';
import Button from '@/shared/ui/Button.astro';
import type { Locale } from '@/shared/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = getHomeCopy(locale);
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
	<div data-reveal class="reveal mx-auto max-w-2xl text-center">
		<p class="text-sm font-semibold uppercase tracking-[0.18em] text-primary">
			{copy.exams.eyebrow}
		</p>
		<h2
			class="mt-3 font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl"
		>
			{copy.exams.title}
		</h2>
		<p class="mt-4 text-lg text-muted">{copy.exams.subtitle}</p>
	</div>

	<div class="mt-12 grid gap-6 md:grid-cols-2">
		<article
			data-reveal
			class="reveal rounded-3xl border border-border bg-surface-elevated p-6 sm:p-8"
		>
			<p class="text-sm font-semibold uppercase tracking-[0.16em] text-accent">
				{copy.exams.dele.title}
			</p>
			<p class="mt-4 text-base leading-relaxed text-muted">
				{copy.exams.dele.text}
			</p>
		</article>
		<article
			data-reveal
			class="reveal rounded-3xl border border-border bg-surface-elevated p-6 sm:p-8"
		>
			<p class="text-sm font-semibold uppercase tracking-[0.16em] text-tertiary">
				{copy.exams.siele.title}
			</p>
			<p class="mt-4 text-base leading-relaxed text-muted">
				{copy.exams.siele.text}
			</p>
		</article>
	</div>

	<div data-reveal class="reveal mt-10 text-center">
		<Button href={localePath(locale, navRoutes.deleSiele)} variant="primary">
			{copy.exams.cta}
		</Button>
	</div>
</section>
