import ExamPrep from '@/features/home/components/ExamPrep.astro';
import Hero from '@/features/home/components/Hero.astro';
import Intro from '@/features/home/components/Intro.astro';
import Services from '@/features/home/components/Services.astro';
import StatsBar from '@/features/home/components/StatsBar.astro';
import type { Locale } from '@/shared/i18n';

interface Props {
