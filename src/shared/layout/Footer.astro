---
import { getTranslations, type Locale } from '@/shared/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-border bg-surface-elevated">
	<div
		class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-10 sm:px-6 md:flex-row md:items-center md:justify-between"
	>
		<div class="min-w-0">
			<p class="font-display text-lg font-semibold text-ink">{t.siteName}</p>
			<p class="mt-2 text-sm text-muted">
				© {year} {t.siteName}. {t.footer.rights}
			</p>
		</div>
		<p class="text-sm text-muted md:text-right">{t.footer.madeBy}</p>
	</div>
</footer>
