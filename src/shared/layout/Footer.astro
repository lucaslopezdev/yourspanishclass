---
import { getTranslations, type Locale } from '@/shared/i18n';
import { localePath, navRoutes, type NavKey } from '@/shared/lib/paths';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const year = new Date().getFullYear();

const links: { key: NavKey; href: string; label: string }[] = [
	{ key: 'home', href: localePath(locale, navRoutes.home), label: t.nav.home },
	{ key: 'about', href: localePath(locale, navRoutes.about), label: t.nav.about },
	{
		key: 'lessons',
		href: localePath(locale, navRoutes.lessons),
		label: t.nav.lessons,
	},
	{
		key: 'deleSiele',
		href: localePath(locale, navRoutes.deleSiele),
		label: t.nav.deleSiele,
	},
	{
		key: 'resources',
		href: localePath(locale, navRoutes.resources),
		label: t.nav.resources,
	},
	{
		key: 'contact',
		href: localePath(locale, navRoutes.contact),
		label: t.nav.contact,
	},
];
---

<footer class="mt-auto border-t border-border bg-surface-elevated">
	<div
		class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:px-6 md:flex-row md:items-start md:justify-between"
	>
		<div class="min-w-0">
			<p class="font-display text-lg font-semibold text-ink">{t.siteName}</p>
			<p class="mt-2 text-sm text-muted">
				© {year} {t.siteName}. {t.footer.rights}
			</p>
		</div>

		<nav aria-label="Footer">
			<ul class="flex flex-wrap gap-x-4 gap-y-2 text-sm text-muted">
				{
					links.map((link) => (
						<li>
							<a
								href={link.href}
								class="inline-block max-w-full leading-snug transition duration-200 hover:text-primary"
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</footer>
